# 비밀 값
.env
.env*.local

# 설치물과 빌드 결과
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# 저장소 밖에 두기로 한 정답 파일. 자리를 잘못 적어 저장소 안에 생겨도 커밋되지 않게 이름으로 막는다.
# (안 여는 세트, 실제 자료의 원문, 실제 자료를 넣은 기록)
test.jsonl
test.v*.jsonl
real.jsonl
real-intake.jsonl

# 검토 메모 같은 로컬 작업 글. 정답 작업 폴더는 저장소 밖(GOLD_WORK_DIR)에 둔다.
.gold-work/

# 로컬 DB 와 도구 흔적
.pgdata/
.vercel/
.DS_Store
npm-debug.log*

# 파이썬 수집기(collector/)의 가상 환경과 흔적. 받아 둔 원자료(.cache)는 저장소에 넣지 않는다.
collector/.venv/
collector/.cache/
collector/.pytest_cache/
__pycache__/
*.pyc
