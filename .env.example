# 값은 여기에 적지 않는다. 이 파일을 .env.local 로 복사한 뒤 직접 채운다.

# 앱이 쓰는 PostgreSQL 연결 주소. 꼴: postgres://사용자@호스트:포트/chaeum
DATABASE_URL=

# 시험(npm run test:db)이 쓰는 연결 주소. DB 이름이 _test 로 끝나야 한다.
TEST_DATABASE_URL=

# (선택) Anthropic API 키. 없으면 녹화 재생으로 돈다. 서버에서만 읽는다.
ANTHROPIC_API_KEY=

# (선택) LLM 방식: anthropic | replay | fake. 비우면 키가 있을 때 anthropic, 없을 때 replay.
LLM_PROVIDER=

# (선택) 모델 이름. 비우면 가장 작은 모델.
LLM_MODEL=

# (선택) 연결 풀 크기. 비우면 3.
PG_POOL_MAX=

# (선택) 1 이면 정답 확인 화면(/label)과 실제 자료 넣기(/label/real), 손글 쓰기(/label/hand)가 열린다. 내 컴퓨터에서만 켠다. 비우면 404.
LABEL_ENABLED=

# (선택) 실제 자료 넣기에서 초안을 채우는 실제 호출의 전체 상한(하루가 아니라 통틀어). 앱의 하루 상한(LIVE_LLM_DAILY_CAP)과 따로 센다.
# 세는 것은 답을 받아 초안이 된 호출과, 서버가 뜬 뒤 답을 못 받은 호출이다(뒤의 것은 서버를 다시 띄우면 0 으로 돌아간다).
# 비우면 60. 0 이면 장부에 답이 있는 글만 채운다. 초안은 언제나 가장 작은 모델로 채운다(LLM_MODEL 을 따르지 않는다). ANTHROPIC_API_KEY 가 있어야 한다.
LABEL_REAL_CALL_CAP=

# (선택) 확인 화면이 원문에서 강조할 표기(칸마다 정해 둔 조각)를 읽는 파일. 비우면 홈 아래 chaeum-gold-work/v2/specs.json.
# 파일이 없으면 강조 없이 돈다.
LABEL_HINTS_PATH=

# (선택) 묶음마다 이번에 확인할 건수. 종류와 글 꼴이 고르게 섞이도록 씨앗으로 고른다. 비우면 연습 20, 안 여는 세트 40.
LABEL_TARGET_DEV=
LABEL_TARGET_TEST=

# (선택) 안 여는 정답 세트가 놓인 자리(저장소 밖). 폴더면 그 안의 test.jsonl. 비우면 홈 아래 chaeum-sealed.
# 절대 경로나 ~ 로 시작하는 길만 받는다. 상대 경로이거나 저장소 안이면 도구와 화면이 멈춘다.
# 실제 자료의 원문(real.jsonl)과 넣은 글의 기록(real-intake.jsonl)도 같은 폴더에 쓴다. 남이 쓴 글이라 저장소에 넣지 않는다.
SEALED_GOLD_PATH=

# (선택) 정답 원문을 쓰는 동안의 작업 폴더(저장소 밖). 비우면 홈 아래 chaeum-gold-work.
GOLD_WORK_DIR=

# (선택) 직접 넣은 글·그림에 진짜 LLM 을 돌리는 하루 전체 건수 상한(호출 하나가 한 건). 비우거나 0 이면 꺼짐.
# 꺼져 있으면 녹화본이 있는 보기 글만 AI 답이 나오고, 나머지는 "규칙만" 길로 간다. 그림·PDF 올리기는 받지 않는다.
# 켜려면 ANTHROPIC_API_KEY 도 있어야 한다. 내 컴퓨터에서는 50 쯤이면 넉넉하다. 1000 보다 큰 값은 1000 으로 읽는다.
LIVE_LLM_DAILY_CAP=
